<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_bg"
    android:orientation="vertical">

    <!-- Top Video Preview Area -->
    <FrameLayout
        android:id="@+id/videoContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.1"
        android:background="@color/black">

        <SurfaceView
            android:id="@+id/surfaceView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Overlay Status Badge -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="12dp"
            android:background="#AA000000"
            android:orientation="horizontal"
            android:padding="8dp">

            <View
                android:id="@+id/statusIndicatorDot"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_gravity="center_vertical"
                android:background="@color/warning_yellow" />

            <TextView
                android:id="@+id/tvLiveStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/status_idle"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>

    <!-- Scrollable Controls Panel for TV & Mobile -->
    <ScrollView
        android:id="@+id/controlsScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Global Settings & Auto Start -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/surface_bg"
                android:orientation="horizontal"
                android:padding="10dp"
                android:layout_marginBottom="10dp">

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchAutoStart"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/auto_start_label"
                    android:textColor="@color/white"
                    android:focusable="true"
                    android:nextFocusDown="@id/btnPlaySlot1"
                    android:background="@drawable/focus_border"
                    android:padding="6dp" />

                <Button
                    android:id="@+id/btnGlobalStop"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/stop"
                    android:backgroundTint="@color/error_red"
                    android:textColor="@color/white"
                    android:focusable="true"
                    android:background="@drawable/focus_border" />
            </LinearLayout>

            <!-- Pipeline Slot 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/surface_bg"
                android:orientation="vertical"
                android:padding="10dp"
                android:layout_marginBottom="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/pipeline_1_label"
                        android:textColor="@color/primary_accent"
                        android:textStyle="bold"
                        android:textSize="14sp" />

                    <Button
                        android:id="@+id/btnPlaySlot1"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:text="@string/play"
                        android:textSize="12sp"
                        android:backgroundTint="@color/primary_accent"
                        android:textColor="@color/black"
                        android:focusable="true"
                        android:background="@drawable/focus_border" />
                </LinearLayout>

                <EditText
                    android:id="@+id/etPipelineSlot1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/focus_border"
                    android:fontFamily="monospace"
                    android:inputType="textMultiLine"
                    android:minLines="2"
                    android:maxLines="5"
                    android:padding="8dp"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:focusable="true" />
            </LinearLayout>

            <!-- Pipeline Slot 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/surface_bg"
                android:orientation="vertical"
                android:padding="10dp"
                android:layout_marginBottom="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/pipeline_2_label"
                        android:textColor="@color/primary_blue"
                        android:textStyle="bold"
                        android:textSize="14sp" />

                    <Button
                        android:id="@+id/btnPlaySlot2"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:text="@string/play"
                        android:textSize="12sp"
                        android:backgroundTint="@color/primary_blue"
                        android:textColor="@color/white"
                        android:focusable="true"
                        android:background="@drawable/focus_border" />
                </LinearLayout>

                <EditText
                    android:id="@+id/etPipelineSlot2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/focus_border"
                    android:fontFamily="monospace"
                    android:inputType="textMultiLine"
                    android:minLines="2"
                    android:maxLines="5"
                    android:padding="8dp"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:focusable="true" />
            </LinearLayout>

            <!-- Pipeline Slot 3 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/surface_bg"
                android:orientation="vertical"
                android:padding="10dp"
                android:layout_marginBottom="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/pipeline_3_label"
                        android:textColor="@color/warning_yellow"
                        android:textStyle="bold"
                        android:textSize="14sp" />

                    <Button
                        android:id="@+id/btnPlaySlot3"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:text="@string/play"
                        android:textSize="12sp"
                        android:backgroundTint="@color/warning_yellow"
                        android:textColor="@color/black"
                        android:focusable="true"
                        android:background="@drawable/focus_border" />
                </LinearLayout>

                <EditText
                    android:id="@+id/etPipelineSlot3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/focus_border"
                    android:fontFamily="monospace"
                    android:inputType="textMultiLine"
                    android:minLines="2"
                    android:maxLines="5"
                    android:padding="8dp"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:focusable="true" />
            </LinearLayout>

            <!-- RTSP Camera Server Broadcast Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/surface_bg"
                android:orientation="vertical"
                android:padding="10dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/rtsp_server_title"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvRtspServerUrl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Server URL: rtsp://&lt;device-ip&gt;:8554/live"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/etRtspPipeline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/focus_border"
                    android:fontFamily="monospace"
                    android:inputType="textMultiLine"
                    android:minLines="2"
                    android:maxLines="4"
                    android:padding="8dp"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp"
                    android:focusable="true" />

                <Button
                    android:id="@+id/btnToggleRtspServer"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="8dp"
                    android:text="@string/start_rtsp"
                    android:backgroundTint="@color/primary_blue"
                    android:textColor="@color/white"
                    android:focusable="true"
                    android:background="@drawable/focus_border" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
